/-
  Authorization — brick 35: complete mediation, and the split row 7 was hiding.

  Row 7 has carried the last **[classified]** grade in the map. Its reasoning:
  "all accesses mediated per policy π" is 1-safety relative to π, and π's own
  correctness "is not a theorem anywhere", so the class is CARRIED. That is true of
  *policy correctness* — and it silently swallowed a second, different property that
  is not spec-shaped at all.

  CWE-285's actual defect, and CWE-306's, is almost never "the policy was wrong". It
  is **missing mediation**: some path reaches the protected operation without passing
  the check. That is a property of the *program*, on every path, and it is decidable.
  This brick separates the two:

  * **mediation** — every access is dominated by a successful check on every path —
    is generated by a decidable analysis and proved sound;
  * **policy correctness** — whether π grants the right things — stays CARRIED, as
    it should, because nothing in a program can witness it.

  The machine is deliberately small. A program is a list of instructions; `check r`
  consults the policy and *aborts* if it refuses; `access r` performs the protected
  read and records it; `branch` offers two paths, and — as in bricks 32 and 33 — the
  path taken is a **data parameter**, so "on some path" is decidable on a witness and
  "on every path" quantifies over all of them.

  What gets proved:

  * **The attack.** `victimMed` checks on one branch and forgets on the other.
    `med_victim_bypasses` — under the path that skips the check, and a policy that
    **denies** the resource, the read happens anyway. Missing authorization as a
    theorem, and note it is a *path* property: the program contains a correct check,
    just not on every route to the access.
  * **The fix, generated.** `medCheck` is a decidable flow-sensitive analysis
    carrying the set of resources authorized so far, intersecting at branch joins.
    `medCheck_sound` — a checked program reads only what the policy permits, on
    **every** path and for **every** policy.
  * **The split, stated as a theorem.** `mediation_generated_policy_carried` pairs
    them: mediation is decided and proved, while `policy_correctness_not_witnessed`
    exhibits two policies under which the *same* checked program is mediated and yet
    grants different resources — so no amount of program analysis can pick the right
    π. That is exactly the CARRIED half, now demonstrated rather than asserted.

  Honest limits. Branch bodies are a separate instruction type, so nesting is excluded
  **by the syntax** (as in brick 33) rather than dropped by the semantics. The analysis
  is path-insensitive at joins (it intersects), so it is sufficient, not necessary. And
  the model has no *subject*: this is "was the resource authorized", not "was it
  authorized *for this principal*" — binding subject to object is IDOR (CWE-639), a
  named follow-on, not something proved here.
-/
import ConfTyping.Imp

namespace ConfTyping

/-! ## The machine -/

/-- What the policy is asked about: a resource name. -/
abbrev MedPolicy := String → Bool

/-- Straight-line instructions. `check` may abort; `access` is the protected
    operation; `pub` is any unprotected step. -/
inductive MedBase where
  | check  : String → MedBase
  | access : String → MedBase
  | pub    : MedBase
  deriving Repr, DecidableEq

/-- A program instruction: a straight-line step, or a two-way branch. -/
inductive MedInstr where
  | base   : MedBase → MedInstr
  | branch : List MedBase → List MedBase → MedInstr
  deriving Repr

/-- Execution state: what has been authorized, what has been read, and whether a
    refused check has aborted the run. -/
structure MedState where
  auth  : List String
  reads : List String
  dead  : Bool
  deriving Repr

def initMed : MedState := ⟨[], [], false⟩

/-! ## Execution -/

/-- One straight-line step. A refused check aborts: nothing after it runs. -/
def medStep (π : MedPolicy) (s : MedState) : MedBase → MedState
  | .check r  => if s.dead then s
                 else if π r then { s with auth := r :: s.auth }
                 else { s with dead := true }
  | .access r => if s.dead then s else { s with reads := r :: s.reads }
  | .pub      => s

def medRunBody (π : MedPolicy) : List MedBase → MedState → MedState
  | [],      s => s
  | b :: bs, s => medRunBody π bs (medStep π s b)

/-- Run a program along a chosen path. The path is a data parameter: one Boolean per
    branch reached, so `∀ path` is the demonic quantification. -/
def medRun (π : MedPolicy) : List Bool → List MedInstr → MedState → MedState
  | _,    [],                  s => s
  | path, .base b :: is,       s => medRun π path is (medStep π s b)
  | path, .branch x y :: is,   s =>
      let body := if path.headD true then x else y
      medRun π (path.tailD []) is (medRunBody π body s)

/-! ## The property -/

/-- **Complete mediation**: on every path and under every policy, every resource the
    program reads is one the policy permits. -/
def Mediated (p : List MedInstr) : Prop :=
  ∀ (π : MedPolicy) (path : List Bool) (r : String),
    r ∈ (medRun π path p initMed).reads → π r = true

/-! ## Two list operations, defined here rather than imported

    This package is mathlib-free, so membership and intersection are defined and
    proved locally — no guessing at which core lemma exists under which name. -/

def memStr (r : String) : List String → Bool
  | []      => false
  | x :: xs => (x == r) || memStr r xs

theorem memStr_mem {r : String} : ∀ {A : List String}, memStr r A = true → r ∈ A
  | [],      h => by simp [memStr] at h
  | x :: xs, h => by
      simp only [memStr, Bool.or_eq_true, beq_iff_eq] at h
      rcases h with h | h
      · exact h ▸ List.mem_cons_self ..
      · exact List.mem_cons_of_mem _ (memStr_mem h)

/-- The intersection of two authorization sets — what *both* branches guarantee. -/
def interStr : List String → List String → List String
  | [],      _ => []
  | x :: xs, B => if memStr x B then x :: interStr xs B else interStr xs B

theorem interStr_left : ∀ {A B : List String} {r : String},
    r ∈ interStr A B → r ∈ A
  | [],      _, _, h => by simp [interStr] at h
  | x :: xs, B, r, h => by
      by_cases hx : memStr x B = true
      · rw [interStr, ite_eq_left hx] at h
        rcases List.mem_cons.mp h with h' | h'
        · exact h' ▸ List.mem_cons_self ..
        · exact List.mem_cons_of_mem _ (interStr_left h')
      · rw [interStr, ite_eq_right hx] at h
        exact List.mem_cons_of_mem _ (interStr_left h)

theorem interStr_right : ∀ {A B : List String} {r : String},
    r ∈ interStr A B → r ∈ B
  | [],      _, _, h => by simp [interStr] at h
  | x :: xs, B, r, h => by
      by_cases hx : memStr x B = true
      · rw [interStr, ite_eq_left hx] at h
        rcases List.mem_cons.mp h with h' | h'
        · exact h' ▸ memStr_mem hx
        · exact interStr_right h'
      · rw [interStr, ite_eq_right hx] at h
        exact interStr_right h

/-! ## The decidable analysis -/

/-- Straight-line analysis: carry the set of resources authorized so far; an access
    to an unauthorized resource is a failure. -/
def medBase : List String → List MedBase → Option (List String)
  | A, []              => some A
  | A, .check r :: bs  => medBase (r :: A) bs
  | A, .access r :: bs => if memStr r A then medBase A bs else none
  | A, .pub :: bs      => medBase A bs

/-- Whole-program analysis. At a join the authorized set is the **intersection** —
    only what both paths guarantee survives. -/
def medCheck : List String → List MedInstr → Option (List String)
  | A, []                    => some A
  | A, .base b :: is         => (medBase A [b]).bind fun A' => medCheck A' is
  | A, .branch x y :: is     =>
      match medBase A x, medBase A y with
      | some A₁, some A₂ => medCheck (interStr A₁ A₂) is
      | _,       _       => none

/-! ## Soundness -/

/-- The runtime invariant the analysis maintains: everything the run has authorized
    was permitted by the policy, everything read so far was permitted, and the
    statically-tracked set under-approximates the dynamic one (when not aborted). -/
def MedInv (π : MedPolicy) (A : List String) (s : MedState) : Prop :=
  (∀ r ∈ s.auth, π r = true) ∧ (∀ r ∈ s.reads, π r = true) ∧
  (s.dead = false → ∀ r ∈ A, r ∈ s.auth)

theorem medStep_inv {π : MedPolicy} {A A' : List String} {s : MedState} {b : MedBase}
    (hinv : MedInv π A s) (hb : medBase A [b] = some A') :
    MedInv π A' (medStep π s b) := by
  obtain ⟨ha, hr, hd⟩ := hinv
  cases b with
  | pub =>
      simp only [medBase, Option.some.injEq] at hb
      subst hb; exact ⟨ha, hr, hd⟩
  | check r =>
      simp only [medBase, Option.some.injEq] at hb
      subst hb
      by_cases hdead : s.dead = true
      · simp only [medStep, ite_eq_left hdead]
        exact ⟨ha, hr, fun hc => absurd (hdead ▸ hc) (by simp)⟩
      · have hd0 : s.dead = false := by simpa using hdead
        simp only [medStep, ite_eq_right hdead]
        by_cases hp : π r = true
        · simp only [ite_eq_left hp]
          refine ⟨?_, hr, ?_⟩
          · intro q hq
            rcases List.mem_cons.mp hq with h | h
            · exact h ▸ hp
            · exact ha q h
          · intro _ q hq
            rcases List.mem_cons.mp hq with h | h
            · exact h ▸ List.mem_cons_self ..
            · exact List.mem_cons_of_mem _ (hd hd0 q h)
        · simp only [ite_eq_right hp]
          exact ⟨ha, hr, fun hc => absurd hc (by simp)⟩
  | access r =>
      simp only [medBase] at hb
      by_cases hmem : memStr r A = true
      · rw [ite_eq_left hmem] at hb
        simp only [Option.some.injEq] at hb
        subst hb
        by_cases hdead : s.dead = true
        · simp only [medStep, ite_eq_left hdead]
          exact ⟨ha, hr, hd⟩
        · have hd0 : s.dead = false := by simpa using hdead
          simp only [medStep, ite_eq_right hdead]
          refine ⟨ha, ?_, hd⟩
          intro q hq
          rcases List.mem_cons.mp hq with h | h
          · exact h ▸ ha r (hd hd0 r (memStr_mem hmem))
          · exact hr q h
      · rw [ite_eq_right hmem] at hb; simp at hb

theorem medRunBody_inv {π : MedPolicy} : ∀ (bs : List MedBase) (A A' : List String)
    (s : MedState), MedInv π A s → medBase A bs = some A' →
    MedInv π A' (medRunBody π bs s)
  | [],      A, A', s, hinv, hb => by
      simp only [medBase, Option.some.injEq] at hb; subst hb; exact hinv
  | b :: bs, A, A', s, hinv, hb => by
      cases b with
      | pub =>
          simp only [medBase] at hb
          exact medRunBody_inv bs A A' _ (medStep_inv hinv rfl) hb
      | check r =>
          simp only [medBase] at hb
          exact medRunBody_inv bs (r :: A) A' _ (medStep_inv hinv rfl) hb
      | access r =>
          simp only [medBase] at hb
          by_cases hmem : memStr r A = true
          · rw [ite_eq_left hmem] at hb
            refine medRunBody_inv bs A A' _ (medStep_inv hinv ?_) hb
            simp only [medBase, ite_eq_left hmem]
          · rw [ite_eq_right hmem] at hb; simp at hb

/-- Intersecting at a join keeps only what **both** branches guarantee — so the
    invariant survives whichever branch actually ran. -/
theorem inv_of_interL {π : MedPolicy} {A₁ A₂ : List String} {s : MedState}
    (h : MedInv π A₁ s) : MedInv π (interStr A₁ A₂) s := by
  obtain ⟨ha, hr, hd⟩ := h
  exact ⟨ha, hr, fun hdead q hq => hd hdead q (interStr_left hq)⟩

theorem inv_of_interR {π : MedPolicy} {A₁ A₂ : List String} {s : MedState}
    (h : MedInv π A₂ s) : MedInv π (interStr A₁ A₂) s := by
  obtain ⟨ha, hr, hd⟩ := h
  exact ⟨ha, hr, fun hdead q hq => hd hdead q (interStr_right hq)⟩

theorem medRun_inv {π : MedPolicy} : ∀ (p : List MedInstr) (path : List Bool)
    (A A' : List String) (s : MedState), MedInv π A s → medCheck A p = some A' →
    MedInv π A' (medRun π path p s)
  | [],                path, A, A', s, hinv, hc => by
      simp only [medCheck, Option.some.injEq] at hc; subst hc; exact hinv
  | .base b :: is,     path, A, A', s, hinv, hc => by
      simp only [medCheck] at hc
      rcases hb : medBase A [b] with _ | A₁
      · rw [hb] at hc; simp at hc
      · rw [hb, Option.bind_some] at hc
        exact medRun_inv is path A₁ A' (medStep π s b) (medStep_inv hinv hb) hc
  | .branch x y :: is, path, A, A', s, hinv, hc => by
      simp only [medCheck] at hc
      rcases hx : medBase A x with _ | A₁
      · rw [hx] at hc; simp at hc
      · rcases hy : medBase A y with _ | A₂
        · rw [hx, hy] at hc; simp at hc
        · rw [hx, hy] at hc
          simp only [medRun]
          by_cases hp : path.headD true
          · simp only [ite_eq_left hp]
            exact medRun_inv is (path.tailD []) _ A' _
              (inv_of_interL (medRunBody_inv x A A₁ s hinv hx)) hc
          · simp only [ite_eq_right hp]
            exact medRun_inv is (path.tailD []) _ A' _
              (inv_of_interR (medRunBody_inv y A A₂ s hinv hy)) hc

/-- **Soundness: a checked program is completely mediated.** On every path, under
    every policy, it reads only what the policy permits. -/
theorem medCheck_sound {p : List MedInstr} {A' : List String}
    (h : medCheck [] p = some A') : Mediated p := by
  intro π path r hr
  have hinv : MedInv π [] initMed := ⟨by simp [initMed], by simp [initMed], by simp⟩
  obtain ⟨_, hreads, _⟩ := medRun_inv p path [] A' initMed hinv h
  exact hreads r hr

/-! ## The attack: a path that forgets the check -/

def resDB : String := "db"

/-- The victim: one branch authorizes, the other goes straight to the read. -/
def victimMed : List MedInstr :=
  [.branch [.check resDB, .access resDB] [.access resDB]]

/-- The fix: authorize on both. -/
def fixedMed : List MedInstr :=
  [.branch [.check resDB, .access resDB] [.check resDB, .access resDB]]

/-- A policy that **denies** the resource. -/
def denyAll : MedPolicy := fun _ => false

/-- **Missing authorization, as a theorem** (axiom-free). Under the path that takes
    the unguarded branch, the protected resource is read even though the policy
    denies it. The program *contains* a correct check — just not on every route. -/
theorem med_victim_bypasses :
    resDB ∈ (medRun denyAll [false] victimMed initMed).reads ∧ denyAll resDB = false := by
  decide

theorem victim_not_mediated : ¬ Mediated victimMed := by
  intro h
  have := h denyAll [false] resDB med_victim_bypasses.1
  exact absurd this (by decide)

theorem med_victim_rejected : medCheck [] victimMed = none := by decide
theorem med_fixed_accepted : (medCheck [] fixedMed).isSome = true := by decide

/-- The fixed program is completely mediated — every path, every policy. -/
theorem fixed_mediated : Mediated fixedMed := by
  have h : medCheck [] fixedMed = some [resDB] := by decide
  exact medCheck_sound h

/-- The guarded path of the victim is fine; it is the *other* path that is not. So
    mediation is genuinely a whole-program, all-paths property, not a local one. -/
theorem victim_guarded_path_is_fine :
    (medRun denyAll [true] victimMed initMed).reads = [] := by decide

/-! ## The split row 7 was hiding -/

/-- Two policies, one permitting and one denying, under which the *same* checked
    program is mediated — and reads different things. No program analysis can prefer
    one: whether π grants the right resources is a specification question, and this
    is the CARRIED half, exhibited rather than asserted. -/
theorem policy_correctness_not_witnessed :
    Mediated fixedMed
  ∧ (medRun (fun _ => true) [true] fixedMed initMed).reads = [resDB]
  ∧ (medRun denyAll [true] fixedMed initMed).reads = [] :=
  ⟨fixed_mediated, by decide, by decide⟩

/-- **Row 7's split, as one theorem.** Mediation is decided and proved — the victim
    rejected and genuinely bypassable, the fix accepted and mediated on every path
    under every policy. Policy correctness is not, and provably cannot be, decided by
    looking at the program. -/
theorem mediation_generated_policy_carried :
    medCheck [] victimMed = none
  ∧ ¬ Mediated victimMed
  ∧ (medCheck [] fixedMed).isSome = true
  ∧ Mediated fixedMed
  ∧ ((medRun (fun _ => true) [true] fixedMed initMed).reads ≠
     (medRun denyAll [true] fixedMed initMed).reads) :=
  ⟨med_victim_rejected, victim_not_mediated, med_fixed_accepted, fixed_mediated, by decide⟩

end ConfTyping
