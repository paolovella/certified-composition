/-
  The worked supply chain — brick 4, session 3: the checker emits conditional
  certificates from declared assumptions, and a concrete trust pipeline.

  A component that consumes an *untrusted input* — one it does not itself
  classify, trusting an upstream to have made it safe — is checked *under the
  declared assumption* that the input is Low. The checker's success then yields
  a conditional certificate whose ledger records exactly that trust assumption
  (`condBoundary_of_check_assuming`): the machine-readable form of "we assume
  the external component classified its output correctly."

  The worked instance is a two-component pipeline: `Biz` copies an upstream
  library's output (`safe`) into the response — secure *assuming* the library
  classified `safe` as Low — followed by `Log`, an unconditionally secure audit
  write. The composite is certified relative to *exactly one* external trust
  assumption, surfaced and accumulated automatically (`supply_chain_ledger`),
  dischargeable when the library is later verified (`supply_chain_discharged`),
  and load-bearing: without it, `Biz` provably leaks (`biz_needs_assumption`).

  This is VULN-COVERAGE row 11 (crypto/library misuse) at the honest IMP scope:
  the *assumption-tracking mechanism* is proved; the external assumption ("the
  library / cipher is correct") stays an assumption — that is the whole content
  of a LEDGER verdict, now mechanized rather than merely classified.
-/
import ConfTyping.LedgerBridge

namespace ConfTyping

/-! ## The checker generates conditional certificates -/

/-- **Conditional certification from a declared assumption.** Check the
    component pretending the untrusted input `x` is Low (the declared trust
    assumption); a passing check yields a certificate conditional on `x`
    actually being Low. The ledger entry `P x = false` is the trust assumption
    made explicit. -/
theorem condBoundary_of_check_assuming
    {c : Cmd} {P : Partition} {x : String}
    (h : secCheck (fun y => if y = x then false else P y) false c = true) :
    CondBoundary c P [P x = false] := by
  intro hsat
  have hx : P x = false := hsat.1
  have hP : (fun y => if y = x then false else P y) = P := by
    funext y
    by_cases hy : y = x
    · subst hy; simp [hx]
    · simp [hy]
  have hb := boundaryNI_of_check h
  rwa [hP] at hb

/-! ## The worked instance: a trust pipeline -/

/-- Business logic: copy the upstream library's output `safe` into the
    response `out`. Secure *assuming* the library classified `safe` as Low. -/
def Biz : Cmd := .assign "out" (.var "safe")

/-- Audit: write a constant to the log — unconditionally secure. -/
def Log : Cmd := .assign "audit" (.num 1)

theorem biz_check (P : Partition) :
    secCheck (fun y => if y = "safe" then false else P y) false Biz = true := by
  simp [secCheck, Biz, exprLow]

/-- **`Biz`'s conditional certificate**, for every deployment classification:
    secure relative to the single trust assumption "the library output `safe`
    is Low." Generated by the checker, not hand-proved. -/
theorem biz_cond (P : Partition) : CondBoundary Biz P [P "safe" = false] :=
  condBoundary_of_check_assuming (biz_check P)

theorem log_check (P : Partition) : secCheck P false Log = true := by
  simp [secCheck, Log, exprLow]

/-- `Log` is unconditionally secure (empty ledger). -/
theorem log_cond (P : Partition) : CondBoundary Log P [] :=
  condBoundary_nil.mpr (boundaryNI_of_check (log_check P))

/-- **The composite carries exactly one external assumption.** The pipeline
    `Biz; Log` is certified relative to the union of the two ledgers —
    `[P "safe" = false] ++ [] = [P "safe" = false]` — the one trust assumption,
    accumulated automatically by `condBoundary_seq`. -/
theorem supply_chain_ledger (P : Partition) :
    CondBoundary (.seq Biz Log) P [P "safe" = false] := by
  have h := condBoundary_seq (biz_cond P) (log_cond P)
  simpa using h

/-- **Discharge.** When the library is later verified — the deployment really
    classifies `safe` as Low — the whole pipeline's certificate collapses to
    unconditional. -/
theorem supply_chain_discharged (P : Partition) (h : P "safe" = false) :
    BoundaryNI (.seq Biz Log) P :=
  condBoundary_discharge (supply_chain_ledger P) ⟨h, trivial⟩

/-! ## The assumption is load-bearing -/

/-- A classification where the library output `safe` is actually High
    (untrusted) and the response `out` is public. -/
def Psafe : Partition := fun y => y == "safe"

def ζ0 : Store := upd (fun _ => 0) "safe" 1
def ζ1 : Store := fun _ => 0

theorem biz_ζ0 : evalStore Biz ζ0 "out" = 1 := by
  simp [Biz, evalStore, eval, evalE, ζ0, upd]

theorem biz_ζ1 : evalStore Biz ζ1 "out" = 0 := by
  simp [Biz, evalStore, eval, evalE, ζ1, upd]

/-- **Without the assumption, `Biz` leaks.** If the upstream did *not* make
    `safe` Low, two runs differing only on the untrusted value produce
    different public responses. So the trust assumption in the ledger is not
    bookkeeping — dropping it is unsound, and the checker's conditional
    certificate is exactly as strong as the assumption it names. -/
theorem biz_needs_assumption : ¬ BoundaryNI Biz Psafe := by
  intro h
  have hle : lowEq Psafe ζ0 ζ1 := by
    intro y hy
    have hyx : y ≠ "safe" := by intro hs; subst hs; simp [Psafe] at hy
    simp [ζ0, ζ1, upd, hyx]
  have key := h ζ0 ζ1 hle "out" (by decide)
  rw [biz_ζ0, biz_ζ1] at key
  exact absurd key (by decide)

end ConfTyping
