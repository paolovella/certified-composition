/-
  The assumption ledger over loops — brick 9: conditional termination-sensitive
  certificates that accumulate their trusted base.

  Brick 4 gave a composable assumption ledger for loop-free `Cmd`; brick 8
  ported the seam to loops. This module ports the ledger, completing the
  supply-chain story for the looping language: a component's termination-sensitive
  guarantee (`WOutNI`, brick 8) can rest on a trusted base `Γ`, the bases
  accumulate by union under the looping seam, and no used assumption can be
  silently dropped.

  The `Sat`/`Ledger` infrastructure is reused verbatim from brick 4 — only the
  certificate changes from `BoundaryNI` to the full fuelled, termination-sensitive
  `WOutNI`. So `WCondBoundary c P Γ := Sat Γ → WOutNI c P`, accumulation is
  `WCondBoundary_seq` (through `WOutNI_seq`), discharge is explicit, and the
  no-silent-discharge witness is now *about the termination channel itself*: a
  loop `while x skip` whose halting-safety rests on the assumption that its guard
  `x` is Low. Under the assumption it is `WOutNI`; without it, the loop leaks
  termination (`wcx_not_unconditional`) — a trust assumption whose violation is a
  halting leak, the sharpest form of the discipline.
-/
import ConfTyping.WhileCompose
import ConfTyping.Ledger

namespace ConfTyping

/-! ## Conditional termination-sensitive certificates -/

/-- A looping boundary certificate relative to a trusted base `Γ`. -/
def WCondBoundary (c : WCmd) (P : Partition) (Γ : Ledger) : Prop :=
  Sat Γ → WOutNI c P

/-! ## Accumulation: the trusted base is the union -/

/-- **The ledger composes by union over loops.** The composite's
    termination-sensitive certificate holds relative to the append of the two
    components' trusted bases — through the looping seam `WOutNI_seq`, so the
    divergence guarantee accumulates with the base. -/
theorem WCondBoundary_seq {c₁ c₂ : WCmd} {P : Partition} {Γ₁ Γ₂ : Ledger}
    (h₁ : WCondBoundary c₁ P Γ₁) (h₂ : WCondBoundary c₂ P Γ₂) :
    WCondBoundary (.seq c₁ c₂) P (Γ₁ ++ Γ₂) := by
  intro hsat
  rw [sat_append] at hsat
  exact WOutNI_seq (h₁ hsat.1) (h₂ hsat.2)

/-! ## Discharge is explicit -/

/-- The empty ledger is exactly the unconditional termination-sensitive
    certificate. -/
theorem WCondBoundary_nil {c : WCmd} {P : Partition} :
    WCondBoundary c P [] ↔ WOutNI c P := by
  constructor
  · intro h; exact h trivial
  · intro h _; exact h

/-- **Discharge.** Collapsing a conditional certificate to an unconditional one
    requires *proving* the whole ledger. -/
theorem WCondBoundary_discharge {c : WCmd} {P : Partition} {Γ : Ledger}
    (h : WCondBoundary c P Γ) (hsat : Sat Γ) : WOutNI c P :=
  h hsat

/-- Weakening: any additional assumption may be added. -/
theorem WCondBoundary_weaken {c : WCmd} {P : Partition} {A : Prop} {Γ : Ledger}
    (h : WCondBoundary c P Γ) : WCondBoundary c P (A :: Γ) :=
  fun hsat => h hsat.2

/-- The checker generates a conditional certificate under a declared trust
    assumption about an untrusted input `x`. -/
theorem WCondBoundary_of_check_assuming
    {c : WCmd} {P : Partition} {x : String}
    (h : wcheck (fun y => if y = x then false else P y) c = true) :
    WCondBoundary c P [P x = false] := by
  intro hsat
  have hx : P x = false := hsat.1
  have hP : (fun y => if y = x then false else P y) = P := by
    funext y; by_cases hy : y = x
    · subst hy; simp [hx]
    · simp [hy]
  have hb := WOutNI_of_wcheck h
  rwa [hP] at hb

/-! ## No silent discharge — a termination-channel witness

    The witness is now specifically about halting: a loop whose guard is an
    untrusted input `x`. Assuming the upstream classified `x` as Low, the loop
    is termination-safe (a Low guard is lockstep); if `x` is actually High, the
    loop's *halting* depends on the secret — the ledger entry `P "x" = false`
    guards the termination channel itself. -/

/-- A loop guarded by the untrusted input `x`. -/
def Wcx : WCmd := .loop (.var "x") .skip

/-- **The conditional certificate.** Assuming `x` is classified Low, the loop is
    termination-sensitively secure — generated by the checker. -/
theorem wcx_cond (P : Partition) : WCondBoundary Wcx P [P "x" = false] :=
  WCondBoundary_of_check_assuming (P := P) (x := "x") (by
    simp [wcheck, Wcx, exprLow])

/-- A store where the untrusted `x` is nonzero. -/
def χ0 : Store := upd (fun _ => 0) "x" 1
def χ1 : Store := fun _ => 0

theorem wcx_χ0_spin : wexec 1 Wcx χ0 = none := by
  simp [wexec, Wcx, evalE, χ0, upd]

theorem wcx_χ1_halt : wexec 1 Wcx χ1 = some (χ1, 1, [false]) := by
  simp [wexec, Wcx, evalE, χ1]

/-- **The unconditional certificate is false** where `x` is actually High: the
    loop halts iff `x = 0`, so two runs agreeing on all public data but
    differing on the untrusted `x` diverge on *whether they halt*. The
    assumption cannot be dropped — and what it guards is the termination
    channel. -/
theorem wcx_not_unconditional : ¬ WOutNI Wcx Phx := by
  intro h
  have hle : lowEq Phx χ0 χ1 := by
    intro y hy
    have hyx : y ≠ "x" := by intro hx; subst hx; simp [Phx] at hy
    simp [χ0, χ1, upd, hyx]
  have key := h 1 χ0 χ1 hle
  rw [wcx_χ0_spin, wcx_χ1_halt] at key
  exact key

/-- **No silent discharge, termination form.** The conditional certificate holds
    under the trust assumption for every classification, yet the unconditional
    certificate fails at a classification where the assumption is false —
    and the failure is a *halting* leak. A ledger entry a looping component
    relies on is load-bearing, and here it guards the termination channel
    itself: the sharpest form of the discipline. -/
theorem wledger_no_silent_discharge :
    (∀ P, WCondBoundary Wcx P [P "x" = false]) ∧ ¬ WOutNI Wcx Phx :=
  ⟨wcx_cond, wcx_not_unconditional⟩

end ConfTyping
